# ===========================================
# PRODUCTION SERVER ENVIRONMENT VARIABLES
# Copy this to /var/www/comhubai/server/.env
# ===========================================

# Server Configuration
PORT=3000
NODE_ENV=production
API_BASE_URL=https://voip.comhubai.com

# Supabase Configuration (REQUIRED - Get from Supabase Dashboard)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Asterisk ARI Configuration (if using Asterisk)
ASTERISK_ARI_URL=http://localhost:8088
ASTERISK_ARI_USERNAME=ariuser
ASTERISK_ARI_PASSWORD=YOUR_ARI_PASSWORD
ASTERISK_ARI_APP_NAME=ai-telephony

# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_WHISPER_MODEL=whisper-1

# Twilio Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_SIP_DOMAIN=your-domain.sip.twilio.com

# Redis Configuration (for Bull queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration (CHANGE THIS!)
JWT_SECRET=GENERATE_A_LONG_RANDOM_STRING_HERE_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Security
CORS_ORIGIN=https://voip.comhubai.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/comhubai/app.log
