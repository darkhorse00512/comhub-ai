# ===========================================
# PRODUCTION CLIENT ENVIRONMENT VARIABLES
# Copy this to /var/www/comhubai/client/.env.production
# ===========================================

# API Configuration (points to your domain)
VITE_API_BASE_URL=https://voip.comhubai.com/api
VITE_WS_URL=https://voip.comhubai.com

# Supabase Configuration (REQUIRED - Get from Supabase Dashboard)
# Use the same values as your server configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
